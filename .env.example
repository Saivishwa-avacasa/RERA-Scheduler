# Copy this file to .env and fill in real values. Never commit .env.
# On GitHub Actions, put the same value in the repository secret DATABASE_URL.

# Required for database storage. Leave empty to write Excel/JSON files only.
# CockroachDB Cloud: Cluster -> Connect -> "General connection string".
# PostgreSQL works too: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/defaultdb?sslmode=verify-full

# Optional: path to the CA certificate for sslmode=verify-full.
# Not needed normally - the scrapers fall back to certs/root.crt in this repo.
# PGSSLROOTCERT=certs/root.crt

# Optional, tests only: set to 1 to run tests/test_db_integration.py against
# DATABASE_URL (it uses a temporary schema and drops it afterwards).
# RERA_DB_INTEGRATION=1
